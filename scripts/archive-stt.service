[Unit]
Description=archive-stt: lesson markup
After=network-online.target
Wants=network-online.target

[Service]
User=archive-stt
WorkingDirectory=/home/archive-stt
EnvironmentFile=/home/archive-stt/archive-stt.env
ExecStart=/home/archive-stt/bin/archive-stt server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
