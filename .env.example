# Settings as ARCHIVE_STT_* variables (a key "ai-trns.url" of config.toml is ARCHIVE_STT_AI_TRNS_URL);
# `archive-stt config` prints them all with their defaults.
# ai-trns (HTTP): a service key from its AI_TRNS_API_KEYS
ARCHIVE_STT_AI_TRNS_URL=http://127.0.0.1:8766
ARCHIVE_STT_AI_TRNS_KEY=
# where the SQLite file and the words are kept
ARCHIVE_STT_DATA_DIR=/var/lib/archive-stt
ARCHIVE_STT_SERVER_BIND_ADDRESS=:8770
# MDB, read only (postgres://user:password@host:5432/mdb?sslmode=disable): a lesson's checked subtitles (made
# before 2027) are its words instead of the STT; empty = the STT only
ARCHIVE_STT_MDB_URL=
# who may start a run (POST /cus/{uid}/markup), name:key,...; empty = only from this host (reading is public)
ARCHIVE_STT_SERVER_API_KEYS=
