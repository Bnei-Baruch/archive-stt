# ai-trns (HTTP): a service key from its AI_TRNS_API_KEYS
ARCHIVE_STT_AI_TRNS_URL=http://127.0.0.1:8766
ARCHIVE_STT_AI_TRNS_KEY=
# where runs, ai-trns's answers and documents are kept
ARCHIVE_STT_DATA_DIR=/var/lib/archive-stt
# who may start a run (POST /markup), name:key,...; empty = anyone (reading is public)
ARCHIVE_STT_API_KEYS=
